generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  passwordHash      String?
  staffPasswordHash String?
  isAdmin           Boolean   @default(false)
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  staffLastLoginAt  DateTime?
  staffLastActiveAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  salesRepresentativeId       String?
  salesRepresentative         SalesRepresentative? @relation("AssignedClientAccounts", fields: [salesRepresentativeId], references: [id], onDelete: SetNull)
  salesPlanCommissionPercent  Decimal?             @db.Decimal(5, 2)
  salesExtraCommissionPercent Decimal?             @db.Decimal(5, 2)

  restaurants          Restaurant[]
  subscription         Subscription?
  passwordResetTokens  PasswordResetToken[]
  printBridgeDevices   PrintBridgeDevice[]
  referralPartner      ReferralPartner?
  aiCreditTransactions AiCreditTransaction[]
  emailUsages          EmailUsage[]
  whatsappUsages       WhatsAppUsage[]
  adminActions         AdminAuditLog[]       @relation("AdminActor")
  adminChanges         AdminAuditLog[]       @relation("AdminTarget")
  salesProfile         SalesRepresentative?  @relation("SalesRepresentativeUser")
  salesCommissions     SalesCommission[]     @relation("CommissionClient")
  commercialRequests   CommercialRequest[]   @relation("RequestClient")
  decidedRequests      CommercialRequest[]   @relation("RequestDecider")
  commercialMessages   CommercialMessage[]
  receivedPromotions   AdminPromotion[]      @relation("PromotionRecipient")
  createdPromotions    AdminPromotion[]      @relation("PromotionCreator")

  @@index([salesRepresentativeId])
  @@index([lastActiveAt])
}

model AdminAuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)

  targetUserId String?
  targetUser   User?   @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  action  String
  details Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model AdminSettings {
  id String @id @default("global")

  emailCostMicros    Int @default(400)
  aiCreditCostMicros Int @default(10000)
  whatsappCostMicros Int @default(5000)

  updatedAt DateTime @updatedAt
}

model SalesRepresentative {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("SalesRepresentativeUser", fields: [userId], references: [id], onDelete: Cascade)

  name  String
  email String  @unique
  phone String?

  active                        Boolean @default(true)
  defaultPlanCommissionPercent  Decimal @default(10) @db.Decimal(5, 2)
  defaultExtraCommissionPercent Decimal @default(5) @db.Decimal(5, 2)

  clients              User[]                     @relation("AssignedClientAccounts")
  commissions          SalesCommission[]
  commissionStatements SalesCommissionStatement[]
  requests             CommercialRequest[]
  messages             CommercialMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model SalesCommission {
  id String @id @default(cuid())

  salesRepresentativeId String
  salesRepresentative   SalesRepresentative @relation(fields: [salesRepresentativeId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("CommissionClient", fields: [userId], references: [id], onDelete: Restrict)

  sourceType  String
  sourceId    String
  description String

  grossAmount       Decimal @db.Decimal(12, 2)
  commissionPercent Decimal @db.Decimal(5, 2)
  commissionAmount  Decimal @db.Decimal(12, 2)
  currency          String  @default("EUR")

  status   String    @default("PENDING")
  earnedAt DateTime  @default(now())
  paidAt   DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([salesRepresentativeId, status, earnedAt])
  @@index([userId, earnedAt])
}

model SalesCommissionStatement {
  id String @id @default(cuid())

  salesRepresentativeId String
  salesRepresentative   SalesRepresentative @relation(fields: [salesRepresentativeId], references: [id], onDelete: Cascade)

  period          String
  currency        String  @default("EUR")
  grossSales      Decimal @default(0) @db.Decimal(12, 2)
  commissionTotal Decimal @default(0) @db.Decimal(12, 2)
  status          String  @default("MISSING")

  invoiceUrl             String?
  invoiceNumber          String?
  invoiceUploadedAt      DateTime?
  invoiceVerifiedAt      DateTime?
  invoiceVerifiedBy      String?
  invoiceRejectedAt      DateTime?
  invoiceRejectionReason String?
  paidAt                 DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesRepresentativeId, period])
  @@index([status, period])
}

model CommercialRequest {
  id String @id @default(cuid())

  salesRepresentativeId String
  salesRepresentative   SalesRepresentative @relation(fields: [salesRepresentativeId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("RequestClient", fields: [targetUserId], references: [id], onDelete: Cascade)

  type           String
  amount         Decimal? @db.Decimal(12, 2)
  duration       String?
  durationMonths Int?
  reason         String
  status         String   @default("PENDING")
  adminNote      String?

  decidedById String?
  decidedBy   User?     @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  promotion AdminPromotion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesRepresentativeId, status, createdAt])
  @@index([targetUserId, createdAt])
  @@index([status, createdAt])
}

model CommercialMessage {
  id String @id @default(cuid())

  salesRepresentativeId String
  salesRepresentative   SalesRepresentative @relation(fields: [salesRepresentativeId], references: [id], onDelete: Cascade)

  senderUserId String
  senderUser   User   @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  body   String
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([salesRepresentativeId, createdAt])
  @@index([salesRepresentativeId, readAt])
}

model AdminPromotion {
  id String @id @default(cuid())

  targetUserId String
  targetUser   User   @relation("PromotionRecipient", fields: [targetUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  requestId String?            @unique
  request   CommercialRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  code           String    @unique
  percentOff     Int
  duration       String    @default("ONCE")
  durationMonths Int?
  expiresAt      DateTime?

  stripeCouponId        String?   @unique
  stripePromotionCodeId String?   @unique
  emailDeliveryId       String?
  status                String    @default("CREATED")
  sentAt                DateTime?
  failureReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetUserId, createdAt])
  @@index([status, createdAt])
}

model Subscription {
  id String @id @default(cuid())

  plan   String @default("ESSENTIALS") // TRIAL, ESSENTIALS, GROWTH
  status String @default("TRIAL") // TRIAL, ACTIVE, CANCELED, PAST_DUE

  trialEndsAt DateTime?

  restaurantLimit        Int @default(1)
  priceMonthly           Int @default(0)
  aiCredits              Int @default(0)
  emailBalance           Int @default(1000)
  emailsSent             Int @default(0)
  whatsappMessageBalance Int @default(0)
  whatsappMessagesSent   Int @default(0)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailUsage {
  id String @id @default(cuid())

  userId       String
  restaurantId String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  reference String @unique
  category  String
  status    String @default("RESERVED")

  aiCreditCharged Int @default(0)
  balanceAfter    Int

  sentAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
}

model WhatsAppUsage {
  id String @id @default(cuid())

  userId       String
  restaurantId String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  reference  String  @unique
  externalId String? @unique
  category   String
  status     String  @default("RESERVED")

  aiCreditCharged Int @default(0)
  balanceAfter    Int

  sentAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
}

model Restaurant {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  email     String?
  phone     String?
  address   String?
  latitude  Float?
  longitude Float?

  // Ficha fiscal sincronizada do Stripe Checkout (fonte oficial)
  billingLegalName       String?
  billingTaxId           String?
  billingTaxIdType       String?
  billingEmail           String?
  billingAddressLine1    String?
  billingAddressLine2    String?
  billingPostalCode      String?
  billingCity            String?
  billingState           String?
  billingCountry         String?
  billingDetailsSyncedAt DateTime?

  // Mini-site — estado/base
  websiteEnabled      Boolean @default(false)
  websiteTemplate     String  @default("PREMIUM")
  websitePrimaryColor String? @default("#111827")

  // Mini-site — hero
  websiteHeadline    String?
  websiteDescription String?
  websiteCuisine     String?
  websiteInstagram   String?
  websiteHeroImage   String?
  websiteLogoImage   String?

  // Mini-site — storytelling
  websiteAboutTitle   String?
  websiteAboutText    String?
  websiteFeatureTitle String?
  websiteFeatureText  String?

  // Mini-site — textos editáveis
  websiteSectionTitle        String?
  websiteSectionText         String?
  websiteGalleryTitle        String?
  websiteGalleryDescription  String?
  websiteLocationTitle       String?
  websiteLocationDescription String?
  websiteFinalCtaTitle       String?
  websiteFinalCtaText        String?
  websiteFaqTitle            String?
  websiteFaqItems            Json?
  websiteSpecialties         String[]  @default([])
  websiteLastGeneratedAt     DateTime?
  websiteAiVersion           String?

  // Mini-site — galeria
  websiteGalleryImage1 String?
  websiteGalleryImage2 String?
  websiteGalleryImage3 String?
  websiteGalleryImage4 String?

  websiteGalleryTitle1 String?
  websiteGalleryTitle2 String?
  websiteGalleryTitle3 String?
  websiteGalleryTitle4 String?

  // Mini-site — menu
  websiteMenuTitle       String?
  websiteMenuDescription String?
  websiteMenuPdf         String?
  websiteMenus           WebsiteMenu[]

  // Mini-site — SEO/domínio
  websiteSeoTitle       String?
  websiteSeoDescription String?
  customDomain          String?
  customDomainVerified  Boolean       @default(false)
  domainOrders          DomainOrder[]

  plan String @default("FREE")

  referralNetworkEnabled          Boolean  @default(false)
  referralDefaultCommissionType   String   @default("PER_PERSON")
  referralDefaultCommissionAmount Decimal  @default(1.5) @db.Decimal(10, 2)
  referralMaxCommissionPerPerson  Decimal? @db.Decimal(10, 2)
  referralAutoAcceptEnabled       Boolean  @default(false)
  referralPaymentMethodId         String?
  referralDefaultDailyCapacity    Int      @default(0)
  referralProfileCuisine          String?
  referralProfileDescription      String?
  referralProfileHeroImage        String?
  referralProfileGallery          String[] @default([])
  referralProfileHighlights       String[] @default([])
  referralProfileMenuUrl          String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  reservationMode           String  @default("TABLES")
  totalCapacity             Int?
  manualApprovalGuests      Int?
  approvalOnTableMerge      Boolean @default(true)
  onlineReservationsEnabled Boolean @default(true)

  mondayOpen   Boolean @default(false)
  mondayLunch  String?
  mondayDinner String?

  tuesdayOpen   Boolean @default(false)
  tuesdayLunch  String?
  tuesdayDinner String?

  wednesdayOpen   Boolean @default(false)
  wednesdayLunch  String?
  wednesdayDinner String?

  thursdayOpen   Boolean @default(false)
  thursdayLunch  String?
  thursdayDinner String?

  fridayOpen   Boolean @default(false)
  fridayLunch  String?
  fridayDinner String?

  saturdayOpen   Boolean @default(false)
  saturdayLunch  String?
  saturdayDinner String?

  sundayOpen   Boolean @default(false)
  sundayLunch  String?
  sundayDinner String?

  tables       Table[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderingCategories OrderingCategory[]
  orderingOrders     OrderingOrder[]

  orderingTableSessions OrderingTableSession[]

  qrOrderingEnabled               Boolean           @default(true)
  qrAllowWaiterCall               Boolean           @default(true)
  qrAllowBillRequest              Boolean           @default(true)
  qrWelcomeMessage                String?
  floorRooms                      FloorRoom[]
  marketingActions                MarketingAction[]
  googleReviewUrl                 String?
  googlePlaceId                   String?
  googleRating                    Float?
  googleReviewCount               Int?
  googlePriceLevel                Int?
  googleBusinessAccountName       String?
  googleBusinessLocationName      String?
  googleBusinessRefreshToken      String?
  googleBusinessTitle             String?
  googleBusinessAddress           String?
  googleBusinessPhotos            String[]          @default([])
  googleBusinessConnectedAt       DateTime?
  googleBusinessSyncedAt          DateTime?
  reviewRedirectThreshold         Int               @default(4)
  reviewAutomationEnabled         Boolean           @default(true)
  reviewDelayHours                Int               @default(12)
  marketingAutopilotEnabled       Boolean           @default(false)
  marketingAutopilotFrequencyDays Int               @default(14)
  marketingAutopilotMaxDiscount   Int               @default(15)
  marketingAutopilotLastRunAt     DateTime?
  revenueWhatsappEnabled          Boolean           @default(false)
  revenueWhatsappNumber           String?           @unique
  revenueWhatsappContentSid       String?
  revenueWhatsappAutoReply        Boolean           @default(true)
  revenueVoiceEnabled             Boolean           @default(false)
  revenueVoiceNumber              String?           @unique
  revenueVoiceForwardNumber       String?
  revenueMissedCallAutoReply      Boolean           @default(true)
  revenueChannelsConfiguredAt     DateTime?
  revenueChannelsLastError        String?
  averageTicket                   Float?            @default(25)
  birthdayOffer                   String?
  recoveryOffer                   String?
  vipOffer                        String?
  bronzeVipOffer                  String?
  silverVipOffer                  String?
  goldVipOffer                    String?
  platinumVipOffer                String?
  posEnabled                      Boolean           @default(false)

  posOrders   POSOrder[]
  posPayments POSPayment[]

  posTableSessions POSTableSession[]

  fiscalIntegration FiscalIntegration?
  fiscalDocuments   FiscalDocument[]

  referralAgreements         ReferralAgreement[]
  referralCommissionRequests ReferralCommissionRequest[]
  referralOffers             ReferralOffer[]
  referralDailyCapacities    ReferralDailyCapacity[]
  acceptedReferralGroups     ReferralGroup[]             @relation("AcceptedReferralRestaurant")
  referralBenefits           ReferralBenefit[]
  aiVisibilityScans          AiVisibilityScan[]
  aiVisibilityOptimizations  AiVisibilityOptimization[]
  aiMarketingCampaigns       AiMarketingCampaign[]
  marketingPromoCards        MarketingPromoCard[]
  revenueConversations       RevenueConversation[]
  posCashRegisters           POSCashRegister[]
  posDiscounts               POSDiscount[]
  posReceipts                POSReceipt[]
  posTableTransfers          POSTableTransfer[]
  posDiscountCodes           POSDiscountCode[]
  posCashMovements           POSCashMovement[]
  productProductionCenters   ProductionCenter[]
  printJobs                  PrintJob[]
  printers                   RestaurantPrinter[]
  printBridgeToken           String?                     @unique
  printBridgeRestaurants     PrintBridgeRestaurant[]
  customers                  Customer[]

  @@unique([userId])
  @@index([customDomain])
}

model DomainOrder {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  domain String
  kind   String // PURCHASE | CONNECT
  status String @default("QUOTED")

  currency         String   @default("EUR")
  providerCurrency String   @default("USD")
  providerPrice    Decimal  @default(0) @db.Decimal(12, 2)
  renewalPrice     Decimal? @db.Decimal(12, 2)
  exchangeRate     Decimal  @default(1) @db.Decimal(12, 6)

  providerPriceCents  Int @default(0)
  servicePercentBps   Int @default(500)
  servicePercentCents Int @default(0)
  serviceFixedCents   Int @default(100)
  stripeFeeBps        Int @default(150)
  stripeFeeFixedCents Int @default(25)
  stripeFeeCents      Int @default(0)
  totalCents          Int

  quoteExpiresAt DateTime
  registrant     Json?
  dnsRecords     Json?
  verification   Json?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?
  stripeRefundId          String?
  providerOrderId         String?
  failureReason           String?

  paidAt      DateTime?
  purchasedAt DateTime?
  verifiedAt  DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([restaurantId, createdAt])
  @@index([domain, status])
  @@index([status, updatedAt])
}

model WebsiteMenu {
  id    String @id @default(cuid())
  title String
  pdf   String

  sortOrder Int @default(0)

  roomId String?
  room   FloorRoom? @relation(fields: [roomId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?

  @@index([restaurantId])
  @@index([roomId])
}

model FloorRoom {
  id String @id @default(cuid())

  name      String
  sortOrder Int    @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tables Table[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  websiteMenus WebsiteMenu[]

  @@index([restaurantId])
}

model Table {
  id       String @id @default(cuid())
  number   Int
  capacity Int

  x     Int    @default(80)
  y     Int    @default(80)
  shape String @default("square")

  mergeGroupId String?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  roomId       String?
  room         FloorRoom? @relation(fields: [roomId], references: [id])

  reservations Reservation[]

  createdAt        DateTime          @default(now())
  posTableSessions POSTableSession[]

  @@index([restaurantId])
  @@index([roomId])
}

model Customer {
  id String @id @default(cuid())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketingOptIn    Boolean   @default(false)
  marketingJoinedAt DateTime?

  birthDate DateTime?

  lastVisitAt       DateTime?
  lastReservationAt DateTime?

  visitCount  Int @default(0)
  totalVisits Int @default(0)

  vipTier   String?
  riskScore Int     @default(0)

  notes String?
  tags  String[] @default([])

  source String? // RESERVATION, MANUAL, IMPORT

  marketingActions     MarketingAction[]
  marketingPromoCards  MarketingPromoCard[]
  revenueConversations RevenueConversation[]
  posTableSessions     POSTableSession[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([email])
  @@index([phone])
}

model Reservation {
  id String @id @default(cuid())

  customerName String
  phone        String
  email        String?
  date         DateTime
  guests       Int

  status String @default("CONFIRMED")

  source      String  @default("MANUAL")
  cancelledBy String?

  notes String?

  approvalReason    String?
  reviewEmailSentAt DateTime?

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt            DateTime              @default(now())
  marketingPromoCard   MarketingPromoCard?
  posTableSessions     POSTableSession[]
  referralGroup        ReferralGroup?
  revenueConversations RevenueConversation[]

  @@unique([restaurantId, customerId, date], name: "Reservation_dedupe_key")
  @@index([restaurantId])
  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([tableId])
  @@index([customerId])
  @@index([reviewEmailSentAt, date])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  purpose   String   @default("RESTAURANT")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model OrderingCategory {
  id           String @id @default(cuid())
  restaurantId String

  name     String
  position Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  products    OrderingProduct[]
  activeInPOS Boolean           @default(true)

  @@index([restaurantId])
}

model OrderingProduct {
  id         String @id @default(cuid())
  categoryId String

  name        String
  description String?

  price Decimal @db.Decimal(10, 2)

  vatRate   Int     @default(23)
  sku       String?
  sortOrder Int     @default(0)

  imageUrl  String?
  allergens String?
  featured  Boolean @default(false)

  active Boolean @default(true)

  category OrderingCategory @relation(fields: [categoryId], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  activeInPOS      Boolean        @default(true)
  activeInOrdering Boolean        @default(true)
  activeOnWebsite  Boolean        @default(true)
  posorderItems    POSOrderItem[]

  printName                String?
  productProductionCenters ProductProductionCenter[]

  @@index([categoryId])
}

model OrderingOrder {
  id           String @id @default(cuid())
  restaurantId String

  tableNumber Int
  tableId     String?

  status String @default("PENDING")
  // PENDING
  // ACCEPTED
  // REJECTED

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  vatTotal Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  posOrderId String?
  acceptedAt DateTime?
  rejectedAt DateTime?
  printedAt  DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  items OrderingOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String?
  session   OrderingTableSession? @relation(fields: [sessionId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([sessionId])
}

model OrderingOrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String?

  productName String
  quantity    Int

  unitPrice Decimal @db.Decimal(10, 2)
  vatRate   Int     @default(23)

  lineSubtotal Decimal @default(0) @db.Decimal(10, 2)
  lineVat      Decimal @default(0) @db.Decimal(10, 2)
  lineTotal    Decimal @default(0) @db.Decimal(10, 2)

  order OrderingOrder @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderingTableSession {
  id           String @id @default(cuid())
  restaurantId String
  tableNumber  Int

  status String @default("OPEN")

  openedAt DateTime  @default(now())
  closedAt DateTime?

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  orders     OrderingOrder[]

  requestedBillAt   DateTime?
  requestedWaiterAt DateTime?

  @@index([restaurantId])
  @@index([restaurantId, status])
}

model MarketingAutomation {
  id           String @id @default(cuid())
  restaurantId String

  type    String
  name    String
  enabled Boolean @default(true)

  triggerDays     Int?
  ratingThreshold Int?

  subject   String?
  message   String?
  offerType String?
  offerText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model ReviewFeedback {
  id            String  @id @default(cuid())
  restaurantId  String
  customerId    String?
  reservationId String?

  rating             Int
  comment            String?
  redirectedToGoogle Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([customerId])
  @@index([reservationId])
}

model MarketingAction {
  id String @id @default(cuid())

  restaurantId String
  customerId   String?
  automationId String?

  type   String
  status String @default("SENT")

